    "db:studio": "prisma studio",
    "db:generate": "prisma generate",
    "db:seed": "tsx scripts/seed.ts",
    "db:reset": "prisma migrate reset"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@react-router/node": "^8",
    "@react-router/serve": "^8",
    "@tiptap/pm": "^3.30.6",
    "@tiptap/react": "^3.30.6",
    "@tiptap/starter-kit": "^3.30.6",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "isbot": "^5.1.36",
    "lucide-react": "^1.38.0",
    "motion": "^13.1.1",
    "openai": "^7.8.0",
    "pg": "^8.23.0",
    "prisma": "^7.10.0",
    "react": "^19.2.7",
    "react-dnd": "^16.0.1",
    "react-dnd-html5-backend": "^16.0.1",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
