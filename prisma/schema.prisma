// saas-marketer — Prisma schema
generator client {
  provider     = "prisma-client"
  output       = "../app/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------- enums

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
}

enum CardStatus {
  IDEA
  READY_TO_FILM
  READY_TO_EDIT
  READY_TO_PUBLISH
  SCHEDULED
}

enum CardSource {
  MANUAL
  URL
  NEWS
  RANDOM
}

enum ActivityType {
  CREATED
  MOVED
  TITLE_CHANGED
  ANGLE_CHANGED
  DESCRIPTION_CHANGED
  ASSIGNED
  UNASSIGNED
  SCRIPT_GENERATED
  SCRIPT_IMPROVED
  SCRIPT_EDITED
  COMMENTED
}

enum RevisionSource {
  AI_GENERATED
  AI_IMPROVED
  MANUAL
}

enum GenerationMode {
  URL
  NEWS
  RANDOM
}

// ---------------------------------------------------------------- core

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  name            String
  passwordHash    String
  avatarHue       Int       @default(280)
  /// Uploaded profile picture, resized client-side before it gets here.
  avatarData      Bytes?
  avatarType      String?
  /// Doubles as the cache key for /avatar/:userId.
  avatarUpdatedAt DateTime?
  createdAt       DateTime  @default(now())

  // ---- bring-your-own AI credentials, set per person in profile settings.
  /// The user's own provider API key, encrypted at rest (see lib/secrets.server.ts).
  /// Never leaves the server: loaders only ever expose `aiKeyHint`.
  aiApiKey        String?
  /// Last four characters of the plaintext key, so the UI can show which key is stored.
  aiKeyHint       String?
  aiKeySetAt      DateTime?
  /// Model id to call. Falls back to DEFAULT_AI_MODEL when unset.
  aiModel         String?
  /// "minimal" | "low" | "medium" | "high" — reasoning depth for the calls.
  aiReasoningEffort String?

  memberships   WorkspaceMember[]
  createdCards  VideoCard[]       @relation("CardCreator")
  assignedCards VideoCard[]       @relation("CardAssignee")
  comments      Comment[]
  revisions     ScriptRevision[]
  statusEvents  StatusEvent[]
  activities    Activity[]
  ideaBatches   IdeaBatch[]
  gameScores    GameScore[]
  sentInvites   Invite[]          @relation("InviteSender")
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())

  members    WorkspaceMember[]
  projects   Project[]
  invites    Invite[]
  gameScores GameScore[]
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String
  userId      String
  role        WorkspaceRole @default(MEMBER)
  createdAt   DateTime      @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
}

model Invite {
  id          String        @id @default(cuid())
  workspaceId String
  email       String
  role        WorkspaceRole @default(MEMBER)
  token       String        @unique @default(cuid())
  invitedById String
  createdAt   DateTime      @default(now())
  acceptedAt  DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy User      @relation("InviteSender", fields: [invitedById], references: [id], onDelete: Cascade)

  @@unique([workspaceId, email])
  @@index([email])
}

model Project {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  slug        String
  /// What this project is about — fed to the AI as context.
  description String?
  /// The audience / topic the videos target, e.g. "indie game developers".
  niche       String?
  createdAt   DateTime @default(now())

  workspace Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  cards     VideoCard[]
  batches   IdeaBatch[]

  @@unique([workspaceId, slug])
}

// ---------------------------------------------------------------- kanban

model VideoCard {
  id        String     @id @default(cuid())
  projectId String
  title     String
  status    CardStatus @default(IDEA)
  position  Float      @default(1000)

  // the angle / objection this video attacks
  angle       String?
  description String?

  // AI provenance
  source        CardSource @default(MANUAL)
  sourceUrl     String?
  sourceTitle   String?
  sourceExcerpt String?    @db.Text

  // script
  script          String?   @db.Text
  scriptUpdatedAt DateTime?

  scheduledFor DateTime?
  createdById  String
  assigneeId   String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  project    Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy  User             @relation("CardCreator", fields: [createdById], references: [id])
  assignee   User?            @relation("CardAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  comments   Comment[]
  revisions  ScriptRevision[]
  events     StatusEvent[]
  activities Activity[]

  @@index([projectId, status, position])
  @@index([assigneeId])
}

model Comment {
  id        String   @id @default(cuid())
  cardId    String
  authorId  String
  body      String   @db.Text
  createdAt DateTime @default(now())

  card   VideoCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  author User      @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([cardId])
}

model ScriptRevision {
  id          String         @id @default(cuid())
  cardId      String
  content     String         @db.Text
  source      RevisionSource
  createdById String
  createdAt   DateTime       @default(now())

  card      VideoCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  createdBy User      @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([cardId, createdAt])
  @@index([createdById, createdAt])
}

model StatusEvent {
  id         String      @id @default(cuid())
  cardId     String
  fromStatus CardStatus?
  toStatus   CardStatus
  userId     String
  createdAt  DateTime    @default(now())

  card VideoCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([cardId, createdAt])
  @@index([userId, createdAt])
}

/// Human-readable audit trail shown on the card.
model Activity {
  id        String       @id @default(cuid())
  cardId    String
  userId    String
  type      ActivityType
  /// The new value, where one applies: column label, new title, assignee name.
  detail    String?
  /// The previous value, where one applies.
  fromValue String?
  createdAt DateTime     @default(now())

  card VideoCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([cardId, createdAt])
}

/// Scores from the little game people play while the AI is thinking.
model GameScore {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String
  score       Int
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([workspaceId, score])
  @@index([userId, score])
}

// ---------------------------------------------------------------- AI idea generation

model IdeaBatch {
  id        String         @id @default(cuid())
  projectId String
  userId    String
  mode      GenerationMode
  sourceUrl String?
  createdAt DateTime       @default(now())

  project     Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  suggestions IdeaSuggestion[]

  @@index([projectId, createdAt])
}

model IdeaSuggestion {
  id        String  @id @default(cuid())
  batchId   String
  title     String
  angle     String
  rationale String? @db.Text

  sourceUrl     String?
  sourceTitle   String?
  sourceExcerpt String? @db.Text

  usedCardId String?
  createdAt  DateTime @default(now())

  batch IdeaBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([batchId])
}
