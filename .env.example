# Copy this file to .env — or just run `npm run dev`, which creates it for you
# with a freshly generated SESSION_SECRET.

# Postgres. Pre-wired for the container in docker-compose.yml (port 5433, so it
# does not collide with a Postgres you may already run on 5432). Point it
# anywhere else and `npm run dev` will leave Docker alone.
DATABASE_URL="postgresql://saasmarketer:saasmarketer@localhost:5433/saas_marketer?schema=public"

# Signs the session cookie AND derives the key that encrypts stored API keys.
# Must be unique per install. Changing it signs everyone out and makes stored
# API keys unreadable, so people have to paste theirs again.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=""

# There is deliberately no OPENAI_API_KEY here. Every person brings their own key
# and sets it under Profile → AI provider, so a shared instance never spends one
# person's credit on everybody else. See docs/self-hosting.md.
